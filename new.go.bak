func NewSorry(text string) error {
	d := DialogBox{
		Form: Sorry,
		Text: text,
	}
	_, err := RunDialog(d)
	if err != nil {
		return err
	}
	return err
}

func NewDetailedSorry(text string, details string) error {
	d := DialogBox{
		Form:    DetailedSorry,
		Text:    text,
		Details: details,
	}
	_, err := RunDialog(d)
	if err != nil {
		return err
	}
	return err
}

